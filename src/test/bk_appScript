function doPost(e) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const data = e.postData ? JSON.parse(e.postData.contents) : e.parameter;
    const action = data.action || 'add';

    if (data.customerId) handleCustomerData(ss, data, action);
    if (data.orderId) handleOrderData(ss, data, action);
    if (data.productId) handleProductData(ss, data, action);

    return successResponse({ message: 'Data processed successfully' });

  } catch (error) {
    return errorResponse(error.toString());
  }
}

function doGet(e) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const action = e.parameter.action;
  
    if (action === 'getCustomers') {
      return getAllCustomers(ss);
    } else if (action === 'getCustomer' && e.parameter.customerId) {
      return getCustomerById(ss, e.parameter.customerId);
    } else if (action === 'getOrders') {
      return getAllOrders(ss);
    } else if (action === 'getOrder' && e.parameter.orderId) {
      return getOrderById(ss, e.parameter.orderId);
    } else if (action === 'getProducts') {
      return getAllProducts(ss);
    } else if (action === 'getProduct' && e.parameter.productId) {
      return getProductById(ss, e.parameter.productId);
    } if (e.parameter.action == 'getStats') {
      return getStats(e);
    } else {
      return errorResponse('Invalid action or missing parameters');
    }

  } catch (error) {
    return errorResponse(error.toString());
  }
}

function handleCustomerData(ss, data, action) {
  const sheet = ss.getSheetByName('CustomerData');
  const allData = sheet.getDataRange().getValues();
  const inputId = data.customerId.toString().trim();

  const rowIndex = allData.findIndex((row, index) => {
    if (index === 0) return false;
    return row[0]?.toString().trim() == inputId;
  });

  const existingRow = rowIndex !== -1 ? allData[rowIndex] : [];
  const newRow = [
    inputId,
    data.fullName || existingRow[1] || '',
    data.address || existingRow[2] || '',
    data.phone || existingRow[3] || '',
    data.orderNumber || existingRow[4] || '',
    data.date || existingRow[5] || ''
  ];

  if (action === 'deleteCustomer') {
    if (rowIndex !== -1) {
      sheet.deleteRow(rowIndex + 1);
    } else {
      throw new Error('Customer ID not found for delete');
    }
  } else if (action === 'updateCustomer') {
    if (rowIndex !== -1) {
      sheet.getRange(rowIndex + 1, 1, 1, newRow.length).setValues([newRow]);
    } else {
      throw new Error('Customer ID not found for update');
    }
  } else {
    sheet.appendRow(newRow);
  }
}

