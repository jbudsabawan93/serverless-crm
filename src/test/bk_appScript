function getStats(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  try {
    const productSheet = ss.getSheetByName('ProductData');
    const customerSheet = ss.getSheetByName('CustomerData');
    const orderSheet = ss.getSheetByName('OrderData');

    const totalProducts = productSheet ? productSheet.getLastRow() - 1 : 0;
    const totalCustomers = customerSheet ? customerSheet.getLastRow() - 1 : 0;
    const totalOrders = orderSheet ? orderSheet.getLastRow() - 1 : 0;

    const finalTotalProducts = Math.max(0, totalProducts);
    const finalTotalCustomers = Math.max(0, totalCustomers);
    const finalTotalOrders = Math.max(0, totalOrders);

    const stats = {
      totalProducts: finalTotalProducts,
      totalCustomers: finalTotalCustomers,
      totalOrders: finalTotalOrders
    };

    return ContentService.createTextOutput(
      JSON.stringify({ status: 'success', data: stats })
    ).setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    console.error('Error fetching stats:', error);
    return ContentService.createTextOutput(
      JSON.stringify({ status: 'error', message: 'Failed to fetch stats' })
    ).setMimeType(ContentService.MimeType.JSON);
  }
}

function successResponse(data) {
  return ContentService.createTextOutput(JSON.stringify({
    status: 'success',
    data: data
  })).setMimeType(ContentService.MimeType.JSON);
}

function errorResponse(message) {
  return ContentService.createTextOutput(JSON.stringify({
    status: 'error',
    message: message
  })).setMimeType(ContentService.MimeType.JSON);
}