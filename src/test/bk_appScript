function getAllCustomers(ss) {
  const sheet = ss.getSheetByName('CustomerData');
  if (!sheet) return errorResponse('Sheet "CustomerData" not found');

  const [headers, ...rows] = sheet.getDataRange().getDisplayValues();
  const data = rows.map(row => ({
    customerId: row[0],
    fullName: row[1],
    address: row[2],
    phone: row[3],
    orderNumber: row[4],
    date: row[5]
  }));

  return successResponse(data);
}

